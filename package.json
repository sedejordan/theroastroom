{
  "name": "theroastroom",
  "version": "1.2.0",
  "private": true,
  "description": "The Roast Room, a football banter site built by Fritt. Stage 3: branded share cards, download and share actions.",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "build": "npm run validate && node ./scripts/buildSite.mjs",
    "validate": "node ./scripts/validate.mjs",
    "test": "node --test ./tests/schema.test.mjs ./tests/shuffleBag.test.mjs ./tests/shareText.test.mjs ./tests/suggestLogic.test.mjs ./tests/siteTools.test.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}